{
    "name": "Calendar",
    "pluginId": "calendar",
    "author": "Holonet",
    "description": "A simple Calendar plugin for Holonet",
    "version": "unspecified",
    "config": {
        "url": {
            "type": "string",
            "description": "The URL to the calendar feed",
            "default": "",
            "required": true
        },
        "refreshInterval": {
            "type": "number",
            "description": "Refresh interval in seconds",
            "default": "300",
            "required": false
        },
        "maxEvents": {
            "type": "number",
            "description": "Maximum number of events to display",
            "default": "5",
            "required": false
        }
    }
}